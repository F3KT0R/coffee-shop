# Copy to apps/api/.env for local development. On Render, set these in the dashboard (render.yaml lists them).

# --- Required -----------------------------------------------------------------------------------
# Local:  npm run dev:db   (PGlite, no Docker) and use the URL below.
# Neon:   the *pooled* connection string (host contains "-pooler"), with ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable
# Neon only: the direct (non-pooled) connection string, used for migrations.
DIRECT_DATABASE_URL=
# Must be 1 with the local PGlite database; leave at the default (5) on Neon.
DB_POOL_SIZE=1

# Public web address, used for links in emails.
PUBLIC_SITE_URL=http://localhost:5173

# --- Required in production ------------------------------------------------------------------------
# Admin login at /admin. Use a long random password (12+ chars).
ADMIN_PASSWORD=
# Signs the admin session cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Protects POST /api/sync (external cron). Generate like SESSION_SECRET.
SYNC_SECRET=

# Opens a direct message with the shop on Instagram (where customers send their order number).
INSTAGRAM_URL=https://ig.me/m/kafekapsule

# --- Shop rules ----------------------------------------------------------------------------------------
# Price = (UK regular price + weight_kg × TRANSPORT_GBP_PER_KG) × bank GBP sell rate × (1 + margin),
# but at least landed cost + MIN_PROFIT_RSD, rounded up to 50 RSD. KaffeK sales are never passed on.
PRICE_MARGIN_PERCENT=30
TRANSPORT_GBP_PER_KG=4
MIN_PROFIT_RSD=100
# Used for the few products without a weight at KaffeK.
FALLBACK_WEIGHT_KG=0.3
DELIVERY_ESTIMATE=5–6 nedelja
POSTAGE_NOTE=Poštarinu (oko 500–750 RSD) plaćate kuriru pri preuzimanju paketa.
# false = catalog only, checkout closed (message below is shown instead).
ORDERS_OPEN=true
ORDERS_CLOSED_MESSAGE=Poručivanje je trenutno pauzirano. Katalog možete razgledati, a porudžbine uskoro ponovo primamo.
# Hours between automatic catalog syncs inside the API process. 0 disables.
AUTO_SYNC_HOURS=24

# --- Email (optional; orders still work without it) ---------------------------------------------------
# Preferred: the Gmail relay (apps/api/mail-relay/Code.gs, deployed as a Google Apps Script web app).
# Works on Render's free plan, which blocks outbound SMTP ports. Same secret in the script and here.
MAIL_RELAY_URL=
MAIL_RELAY_SECRET=
MAIL_FROM_NAME="Kafe za Vas"
# Alternative, only on a paid Render instance: Gmail SMTP with an app password (smtp.gmail.com, 465).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kafe za Vas <you@gmail.com>"
# Receives a notification for every new order (with the Gmail app on your phone, that is a push notification).
ADMIN_EMAIL=

LOG_LEVEL=info
