{
  "name": "@kafeshop/api",
  "version": "2.0.0",
  "private": true,
  "description": "Fastify API: catalog, cart pricing, orders, admin and the KaffeK catalog sync.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:prod": "prisma migrate deploy && node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:local": "tsx scripts/db-local.ts",
    "db:deploy": "prisma migrate deploy",
    "db:migration": "tsx scripts/new-migration.ts",
    "db:studio": "prisma studio",
    "sync:now": "tsx --env-file-if-exists=.env scripts/sync-now.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@kafeshop/core": "*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.11",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prisma": "7.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "pino-pretty": "^13.1.3",
    "tsx": "4.23.15"
  }
}
